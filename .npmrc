# The @deepseek-ai/* peer packages (dsh-llm, dsh-agent, dsh-scope, ...) are
# provided by the consumer's dsh installation, not by this repository. Some of
# their transitive npm releases are incomplete (e.g. dsh-type-meta is not
# published), so never auto-install peers here: devDependencies list only the
# packages this bundle actually imports, and they resolve at the consumer's
# peer layer at install time.
auto-install-peers=false
